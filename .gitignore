# never commit vendor firmware or anything derived from it
*.bin
*.zip
unp*/
refs/
work/
gfx/
__pycache__/
*.pyc
studio/__pycache__/

# fonts people add to Studio are theirs, not ours
studio/fonts/

# a composition is the user's working file, not ours
studio/screens.json

# the spy is built, not committed; and the vendor library is never copied here
tools/spy/*.dll
tools/spy/*.lib
tools/spy/*.exp
tools/spy/*.obj
tools/spy/spy.c
tools/spy/spy.def
tools/spy/htusb_real.def
